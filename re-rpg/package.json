{
  "name": "re-rpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Re-RPG: a mobile landscape roguelike RPG",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run cards:validate && npm run world:validate && npm run test && npm run build",
    "sim": "tsx --tsconfig tsconfig.json src/core/sim/cli.ts",
    "playtest": "tsx --tsconfig tsconfig.json scripts/playtest.ts",
    "cards:validate": "tsx --tsconfig tsconfig.json scripts/cards-validate.ts",
    "world:validate": "tsx --tsconfig tsconfig.json scripts/world-validate.ts"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
