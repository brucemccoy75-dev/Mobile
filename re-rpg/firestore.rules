rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player; only its owner can read or write it.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
